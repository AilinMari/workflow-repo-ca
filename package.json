    "serve": "live-server --port=5500"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.31.0",
    "@vitest/ui": "^3.1.4",
    "concurrently": "^9.1.2",
    "dotenv": "^16.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^8.0.0",
    "jsdom": "^22.0.0",
    "lint-staged": "^13.0.0",
    "live-server": "^1.2.0",
    "prettier": "^2.0.0",
    "tailwindcss": "^3.4.12",
    "vitest": "^3.1.4"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
